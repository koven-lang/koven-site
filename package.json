{
  "name": "koven-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/sync_content.py --validate-snapshot && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync-content": "python3 scripts/sync_content.py",
    "test": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "check-content": "python3 scripts/sync_content.py --check"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  }
}
